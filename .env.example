# ==========================================
# SUPABASE STORAGE CONFIGURATION (FREE 1GB)
# ==========================================
# 1. สมัครฟรีที่ https://supabase.com แล้วกด "New Project"
# 2. ไปที่เมนู "Storage" ทางซ้าย -> กด "New bucket"
#    - ตั้งชื่อ Bucket Name: homespace
#    - ติ๊กถูกที่ "Public bucket" (เพื่อให้ทุกคนในบ้านโหลดรูปดูได้เร็ว)
# 3. ไปที่ Project Settings (รูปฟันเฟือง) -> เมนู "API"
#    - คัดลอก Project URL มาใส่ที่ SUPABASE_URL
#    - คัดลอก anon public key มาใส่ที่ SUPABASE_ANON_KEY
# 4. บน Vercel: นำค่าทั้ง 3 ตัวนี้ไปใส่ใน Vercel Dashboard -> Settings -> Environment Variables

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_STORAGE_BUCKET=homespace
